			}]
			title: "The Most Insane Magnets"
			x: -7.0d
			y: 3.5d
		}
		{
			dependencies: [
				"22D826F87313D555"
				"4F32E2A23F08BB0E"
			]
			description: [
				"Outside of exotic liquid blankets, tritium can be produced through &aneutron bombardment of deuterium&r."
				""
				"Which basically translates to making your old nuclear reactors from tier 5 &bextra wet&r with heavy water."
				""
				"This process is very inefficient but will be needed to get your initial supply."
				""
				"After that the liquid could probably be swapped with &esomething else&r to make the setup still useful. "
				""
				"Probably a good idea to have some tritium always produced and stored if your reactor ever shits itself so badly you don't notice it until all your tritium decays away. &6Hint Hint&r."
			]
			icon: "compactmachines:wall"
